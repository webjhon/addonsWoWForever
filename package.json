{
  "name": "wow-addon-ai-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-agnostic factory for WoW Forever Alliance 1-60 leveling addons",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dungeon:prepare": "node scripts/prepare-dungeon-trail.mjs",
    "dungeon:verify": "node --experimental-strip-types scripts/verify-dungeon-trail.ts",
    "dungeon:preview": "node scripts/preview-dungeon-trail.mjs",
    "knowledge:validate": "node --experimental-strip-types scripts/knowledge-pack.ts validate",
    "knowledge:coverage": "node --experimental-strip-types scripts/knowledge-pack.ts coverage",
    "knowledge:refresh": "node --experimental-strip-types scripts/knowledge-pack.ts refresh",
    "knowledge:export": "node --experimental-strip-types scripts/knowledge-pack.ts export",
    "init": "node --experimental-strip-types scripts/setup.ts",
    "index": "node --experimental-strip-types rag/indexer.ts",
    "index:embeddings": "node --experimental-strip-types rag/indexer.ts --embeddings",
    "search": "node --experimental-strip-types scripts/factory.ts search",
    "knowledge": "node --experimental-strip-types scripts/factory.ts knowledge",
    "capability": "node --experimental-strip-types scripts/factory.ts capability",
    "agent": "node --experimental-strip-types orchestrator.ts --prompt",
    "example": "node --experimental-strip-types orchestrator.ts --blueprint evals/fixtures/alliance-level-pulse.blueprint.json",
    "build": "node --experimental-strip-types tools/build-addon.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "evals": "node --experimental-strip-types evals/run-evals.ts",
    "mcp": "node --experimental-strip-types mcp/server.ts",
    "doctor": "node --experimental-strip-types scripts/factory.ts doctor",
    "sources:check": "node --experimental-strip-types tools/check-source-updates.ts",
    "new": "node --experimental-strip-types tools/new-addon.ts",
    "skills:context": "node --experimental-strip-types scripts/factory.ts skills",
    "patterns:context": "node --experimental-strip-types scripts/factory.ts patterns",
    "rag:prepare": "node scripts/prepare-rag-corpus.mjs",
    "rag:model": "node --experimental-strip-types scripts/rag.ts model",
    "rag:embed": "node --experimental-strip-types scripts/rag.ts embed",
    "rag:status": "node --experimental-strip-types scripts/rag.ts status",
    "rag:eval": "node --experimental-strip-types evals/rag-retrieval.ts"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "fengari": "0.1.5",
    "luaparse": "0.3.1"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.3.2"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WoW Forever Alliance and Horde Leveling Addon Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "addonName",
    "game",
    "faction",
    "purpose",
    "minLevel",
    "maxLevel",
    "interfaceVersion",
    "version",
    "eventsRegistered",
    "apiNamespacesUsed",
    "apiEvidence",
    "files",
    "interactivity"
  ],
  "properties": {
    "addonName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{2,55}$"
    },
    "game": {
      "const": "WoW Forever"
    },
    "faction": {
      "enum": [
        "Both",
        "Alliance",
        "Horde"
      ],
      "description": "Both required for new/revised addons; exact historical single-faction candidates remain labeled."
    },
    "purpose": {
      "const": "leveling"
    },
    "minLevel": {
      "const": 1
    },
    "maxLevel": {
      "const": 60
    },
    "interfaceVersion": {
      "const": 16001
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "eventsRegistered": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "apiNamespacesUsed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "apiEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "symbol",
          "status",
          "source"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "status": {
            "enum": [
              "CONFIRMED_IN_CLIENT",
              "EXPORTED_FROM_CLIENT",
              "OFFICIAL_DOCUMENTATION",
              "COMMUNITY_VERIFIED",
              "COMMUNITY_UNVERIFIED",
              "UNVERIFIED"
            ]
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "filename",
          "content"
        ],
        "properties": {
          "filename": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "interactivity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playerBenefit",
        "liveSignals",
        "automaticTransitions",
        "nextBestAction",
        "recovery",
        "manualAsFallbackOnly",
        "acceptanceScenarios",
        "testFile"
      ],
      "properties": {
        "playerBenefit": {
          "type": "string",
          "minLength": 16
        },
        "liveSignals": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "level",
              "xp",
              "quests",
              "map",
              "time",
              "pet",
              "inventory",
              "combat",
              "group",
              "character",
              "stats",
              "profession",
              "equipment"
            ]
          }
        },
        "automaticTransitions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "trigger",
              "response"
            ],
            "properties": {
              "trigger": {
                "type": "string",
                "minLength": 16
              },
              "response": {
                "type": "string",
                "minLength": 16
              }
            }
          }
        },
        "nextBestAction": {
          "type": "string",
          "minLength": 16
        },
        "recovery": {
          "type": "string",
          "minLength": 16
        },
        "manualAsFallbackOnly": {
          "const": true
        },
        "acceptanceScenarios": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "required": [
              "given",
              "when",
              "then"
            ],
            "properties": {
              "given": {
                "type": "string",
                "minLength": 16
              },
              "when": {
                "type": "string",
                "minLength": 16
              },
              "then": {
                "type": "string",
                "minLength": 16
              }
            }
          }
        },
        "testFile": {
          "type": "string",
          "pattern": "^tests/[A-Za-z0-9_.-]+\\.test\\.ts$"
        }
      }
    },
    "factionSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataStrategy",
        "unknownFaction",
        "acceptanceFactions",
        "testFile"
      ],
      "properties": {
        "dataStrategy": {
          "enum": [
            "shared-live-state",
            "partitioned-data"
          ]
        },
        "unknownFaction": {
          "type": "string",
          "minLength": 16
        },
        "acceptanceFactions": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Alliance",
              "Horde"
            ]
          }
        },
        "testFile": {
          "type": "string",
          "pattern": "^tests/[A-Za-z0-9_.-]+\\.test\\.ts$"
        }
      }
    },
    "distribution": {
      "type": "string",
      "enum": [
        "candidate",
        "public"
      ],
      "description": "Packaging hygiene only; never implies client verification or publication."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "faction": {
            "const": "Both"
          }
        }
      },
      "then": {
        "required": [
          "factionSupport"
        ],
        "properties": {
          "factionSupport": {
            "$ref": "#/properties/factionSupport"
          }
        }
      }
    }
  ]
}
